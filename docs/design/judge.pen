                                {
                                  "type": "text",
                                  "id": "n139_232",
                                  "name": "Code Editor",
                                  "fill": "$accent",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "var twoSum = function(nums, target) {\n    const map = new Map();\n    for (let i = 0; i < nums.length; i++) {\n        const complement = target - nums[i];\n        // Check if complement exists in map\nif (map.has(complement)) {\n            return [map.get(complement), i];\n        }\n        map.set(nums[i], i);\n    }\n    return [];\n};",
                                  "lineHeight": 1.714,
                                  "fontFamily": "JetBrains Mono",
                                  "fontSize": 14
                                }
                              ]
                            },
